meta {
  name: /login/refresh
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/login/refresh
  body: json
  auth: inherit
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const jwt = res.getBody();
  bru.setVar("jwt", jwt.token);
  bru.setVar("refreshToken", jwt.refreshToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
